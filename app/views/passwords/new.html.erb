<div class="auth-container">
  <h1>🔑 Забыли пароль?</h1>

  <% if flash[:alert] %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="notice"><%= flash[:notice] %></div>
  <% end %>

  <p class="auth-hint">Введите email, и мы отправим инструкции по сбросу пароля.</p>

  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>

    <%= form.submit "Отправить инструкции" %>
  <% end %>

  <div class="links">
    <%= link_to "Вспомнили пароль? Войти", new_session_path %>
  </div>
</div>
