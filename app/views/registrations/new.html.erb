<h1>Регистрация</h1>

<% if flash[:alert] %>
  <div style="color:red"><%= flash[:alert] %></div>
<% end %>

<%= form_with model: @user, url: registration_path do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red">
      <h2>Ошибки:</h2>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Имя" %><br>
    <%= form.text_field :name, required: true, autofocus: true %>
  </div>

  <div>
    <%= form.label :email_address, "Email" %><br>
    <%= form.email_field :email_address, required: true, autocomplete: "username" %>
  </div>

  <div>
    <%= form.label :password, "Пароль" %><br>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Повторите пароль" %><br>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div>
    <%= form.submit "Зарегистрироваться" %>
  </div>
<% end %>

<br>
<%= link_to "Уже есть аккаунт? Войти", new_session_path %>
