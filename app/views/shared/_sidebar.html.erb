<aside class="sidebar">
  <%= link_to root_path, class: "sidebar-logo" do %>
    🌱 Планировщик
  <% end %>

  <nav class="sidebar-nav">
    <%= link_to root_path, class: "sidebar-item #{'active' if current_page?(root_path)}" do %>
      <span class="icon">📅</span>
      <span>Календарь</span>
    <% end %>

    <%# Сад привычек + подпункты %>
    <%= link_to garden_path, class: "sidebar-item #{'active' if current_page?(garden_path) && !current_page?(garden_laboratory_path) && !current_page?(garden_almanac_path)}" do %>
      <span class="icon">🌱</span>
      <span>Сад привычек</span>
    <% end %>

    <%# Подпункты — показываем только когда мы в разделе "Сад" %>
    <% if current_page?(garden_path) || current_page?(garden_laboratory_path) || current_page?(garden_almanac_path) %>
      <div class="sidebar-submenu">
        <%= link_to garden_laboratory_path, class: "sidebar-subitem #{'active' if current_page?(garden_laboratory_path)}" do %>
          <span class="icon">🧪</span>
          <span>Лаборатория</span>
        <% end %>

        <%= link_to garden_almanac_path, class: "sidebar-subitem #{'active' if current_page?(garden_almanac_path)}" do %>
          <span class="icon">📊</span>
          <span>Альманах</span>
        <% end %>
      </div>
    <% end %>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user">
      <span>👤</span>
      <span><%= Current.user.name || Current.user.email_address %></span>
    </div>
    <%= link_to session_path, data: { turbo_method: :delete }, class: "sidebar-item" do %>
      <span class="icon">⏻</span>
      <span>Выйти</span>
    <% end %>
  </div>
</aside>