<h1>Вход</h1>

<% if flash[:alert] %>
  <div style="color:red"><%= flash[:alert] %></div>
<% end %>
<% if flash[:notice] %>
  <div style="color:green"><%= flash[:notice] %></div>
<% end %>

<%= form_with url: session_path do |form| %>
  <div>
    <%= form.label :email_address, "Email" %><br>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
  </div>

  <div>
    <%= form.label :password, "Пароль" %><br>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>

  <div>
    <%= form.submit "Войти" %>
  </div>
<% end %>

<br>
<%= link_to "Забыли пароль?", new_password_path %>
<br>
<%= link_to "Нет аккаунта? Зарегистрироваться", new_registration_path %>
