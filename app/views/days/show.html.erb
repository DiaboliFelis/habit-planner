<div class="page-container" data-controller="modal">
    <% if flash[:alert] %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="notice"><%= flash[:notice] %></div>
  <% end %>
  
  <header class="page-header">
    <div class="page-header-left">
      <%= link_to "←", root_path, class: "btn-icon back-btn", title: "Назад" %>
      <div>
        <h1 class="page-header-title"><%= l(@date, format: "%-d %B") %></h1>
        <p class="text-muted text-small"><%= l(@date, format: "%A").capitalize %></p>
      </div>
    </div>
    <div class="page-header-left">
      <button class="btn btn-primary btn-add" data-action="click->modal#open">
        <span>+</span>
        <span class="btn-label">Событие</span>
      </button>
      <button class="avatar" title="<%= Current.user.name || Current.user.email_address %>">
        <%= (Current.user.name || Current.user.email_address).first.upcase %>
      </button>
    </div>
  </header>

  <%# Секция Событий %>
  <div class="day-events">
    <h2 class="day-section-title">📅 События</h2>

    <% if @events.any? %>
      <% @events.each do |event| %>
        <div class="event-card">
          <div class="event-time">
            <%= event.start_time.strftime("%H:%M") %>–<%= event.end_time.strftime("%H:%M") %>
          </div>
          <div class="event-title"><%= event.title %></div>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state" style="padding: 30px;">
        <div class="empty-icon" style="font-size: 32px;">📅</div>
        <p>На этот день событий нет</p>
      </div>
    <% end %>
  </div>

  <%# Секция Привычек %>
  <div class="day-habits" style="margin-top: var(--space-xl);">
    <h2 class="day-section-title">🌱 Мои привычки на сегодня</h2>

    <% if @habits.any? %>
      <div class="habits-list">
        <% @habits.each do |habit| %>
          <div class="habit-card <%= 'wilted' if habit.wilted? %>">
            <div class="habit-info">
              <div class="plant-pot">
                <span class="plant"><%= habit.plant_emoji %></span>
              </div>
              <div>
                <h3><%= habit.name %></h3>
                <p class="text-muted text-small">
                  Стрик: <%= habit.current_streak || 0 %> дней
                </p>
              </div>
            </div>
            
            <div>
              <% if habit.completed_today? %>
                <span class="badge-success">Выполнено ✅</span>
              <% else %>
                <%# Передаем return_to, чтобы вернуться на эту страницу %>
                <%= button_to "Выполнено", complete_habit_path(habit, return_to: day_path(@date)), method: :patch, class: "btn btn-primary btn-sm" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state" style="padding: 30px;">
        <div class="empty-icon" style="font-size: 32px;">🌱</div>
        <p>У тебя пока нет привычек. Создай их в Саду.</p>
        <%= link_to "Перейти в Сад", garden_path, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>

  <%# Модалка для создания события (остается без изменений) %>
  <div class="modal-overlay" data-modal-target="overlay" data-action="click->modal#closeOnBackdrop">
    <div class="modal">
      <div class="modal-header">
        <h2 class="modal-title">Новое событие</h2>
        <button class="modal-close" data-action="click->modal#close" title="Закрыть">×</button>
      </div>

      <%= form_with model: Event.new, url: events_path, method: :post do |form| %>
        <%= hidden_field_tag :date, @date.strftime("%Y-%m-%d") %>

        <div class="form-field">
          <%= form.label :title, "Название" %>
          <%= form.text_field :title, required: true, placeholder: "Например: Лекция" %>
        </div>

        <div class="form-field">
          <%= form.label :description, "Описание (необязательно)" %>
          <%= form.text_area :description, rows: 2 %>
        </div>

        <div class="form-field">
          <%= form.label :start_time, "Начало" %>
          <%= form.time_field :start_time, value: "09:00", required: true %>
        </div>

        <div class="form-field">
          <%= form.label :end_time, "Окончание" %>
          <%= form.time_field :end_time, value: "10:00", required: true %>
        </div>

        <div style="display: flex; gap: var(--space-sm); margin-top: var(--space-lg);">
          <button type="button" class="btn btn-secondary btn-block" data-action="click->modal#close">
            Отмена
          </button>
          <%= form.submit "Создать", class: "btn btn-primary btn-block" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
