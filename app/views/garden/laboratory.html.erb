<div class="page-container">
  <header class="page-header">
    <div class="page-header-left">
      <%= back_button %>
      <h1 class="page-header-title">🧪 Лаборатория</h1>
    </div>
    <div class="page-header-left">
      <button class="avatar" title="<%= Current.user.name || Current.user.email_address %>">
        <%= (Current.user.name || Current.user.email_address).first.upcase %>
      </button>
    </div>
  </header>

  <%= render "tabs" %>

  <div class="garden-card" style="display: block;">
    <div class="habits-list">
      <% @templates.each do |template| %>
        <div class="habit-card">
          <div class="habit-info">
            <div class="plant-pot"><span class="plant"><%= template.icon %></span></div>
            <div>
              <h3><%= template.name %></h3>
              <p class="text-muted text-small"><%= template.description %></p>
              <p class="text-small" style="color: var(--color-success); margin-top: 4px;">✨ <%= template.benefits %></p>
            </div>
          </div>
          <div>
            <%= button_to "Добавить", habits_path(habit: { name: template.name, goal: template.description, frequency: 1 }), method: :post, class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>